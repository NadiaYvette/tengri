{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tricorder": {
      "command": "tricorder-mcp"
    },
    "contextful": {
      "command": "cxf",
      "args": ["server"]
    },
    "codegraph": {
      "command": "codegraph-mcp",
      "args": ["--mcp", "-w", "."]
    },
    "open-kioku": {
      "command": "open-kioku",
      "args": ["mcp", "serve", "--repo", "."]
    },
    "haskell-language-server": {
      "command": "haskell-language-server",
      "args": ["--lsp"]
    },
    "gopls": {
      "command": "gopls"
    },
    "dhall-lsp-server": {
      "command": "/home/nyc/src/dhall-haskell/dist-newstyle/build/x86_64-linux/ghc-9.14.1/dhall-lsp-server-1.1.4/x/dhall-lsp-server/build/dhall-lsp-server/dhall-lsp-server"
    }
  }
}
