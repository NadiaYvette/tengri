cabal-version: 3.0
name: tengri-darkhan
version: 0.1.0.0
synopsis: Abductive spine and arity bridge synthesizer powered by Gargamelle and Gongju
description:
  Abductive spine and arity bridge synthesizer powered by Gargamelle and Gongju for the tengri ecosystem.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/tengri
bug-reports: https://github.com/NadiaYvette/tengri/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.10.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/tengri
  subdir: packages/tengri-darkhan

library
  exposed-modules:
    Tengri.Darkhan
    Tengri.Darkhan.Articulate
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 3,
    containers >= 0.6 && < 0.9,
    gongju >= 0.1 && < 0.2,
    polytropos-core >= 0.1.1.0 && < 0.2,
    witherable >= 0.4 && < 0.6,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-fol >= 0.1 && < 0.2,
    gargamelle-equational >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    base >= 4.14 && < 5,
    tengri-darkhan,
    text >= 2.0 && < 3,
    containers >= 0.6 && < 0.9,
    hspec >= 2.10 && < 2.12,
    gongju >= 0.1 && < 0.2,
    polytropos-core >= 0.1.1.0 && < 0.2,
    witherable >= 0.4 && < 0.6,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-fol >= 0.1 && < 0.2,
    gargamelle-equational >= 0.1 && < 0.2
