cabal-version: 3.0
name: tengri-lus
version: 0.1.0.0
synopsis: Stream channels, regex conduits, and evacuable aggregation
description:
  Stream channels, regex conduits, and evacuable aggregation for the tengri ecosystem.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/tengri
bug-reports: https://github.com/NadiaYvette/tengri/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/tengri
  subdir: packages/tengri-lus

library
  exposed-modules:
    Tengri.Lus
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    FlexibleInstances
    OverloadedStrings
    ScopedTypeVariables
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    nonempty-containers >= 0.3 && < 1

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    FlexibleInstances
    OverloadedStrings
    ScopedTypeVariables
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    base >= 4.14 && < 5,
    tengri-lus,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    nonempty-containers >= 0.3 && < 1,
    hspec >= 2.10 && < 2.12
