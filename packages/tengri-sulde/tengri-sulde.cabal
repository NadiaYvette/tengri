cabal-version: 3.0
name: tengri-sulde
version: 0.1.0.0
synopsis: Precompiled algebraic prelude re-exporting gongju and polytropos
description:
  Precompiled algebraic prelude re-exporting gongju, polytropos, and penelope for the tengri ecosystem.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/tengri
bug-reports: https://github.com/NadiaYvette/tengri/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/tengri
  subdir: packages/tengri-sulde

library
  exposed-modules:
    Tengri.Sulde
    Tengri.Sulde.GitUrl
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    AllowAmbiguousTypes
    DataKinds
    DerivingStrategies
    FlexibleContexts
    FlexibleInstances
    GADTs
    KindSignatures
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    filepath >= 1.4 && < 1.6,
    directory >= 1.3 && < 1.4,
    process >= 1.6 && < 1.7,
    gongju >= 0.1 && < 0.2,
    polytropos-core >= 0.1 && < 0.2,
    penelope-core >= 0.1 && < 0.2,
    penelope-effects >= 0.1 && < 0.2,
    witherable >= 0.4 && < 1

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    AllowAmbiguousTypes
    DataKinds
    DerivingStrategies
    FlexibleContexts
    FlexibleInstances
    GADTs
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    base >= 4.14 && < 5,
    tengri-sulde,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    polytropos-core >= 0.1 && < 0.2,
    witherable >= 0.4 && < 1,
    hspec >= 2.10 && < 2.12
