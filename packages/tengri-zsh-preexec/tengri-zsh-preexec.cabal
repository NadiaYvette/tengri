cabal-version: 3.0
name: tengri-zsh-preexec
version: 0.1.0.0
synopsis: zsh preexec hook preprocessor
description:
  In the zsh preexec hook, it does handling of lines to avoid fragility
  with quoting and spawns tengri as-needed.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: User Interfaces
homepage: https://github.com/NadiaYvette/tengri
bug-reports: https://github.com/NadiaYvette/tengri/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.10.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/tengri
  subdir: packages/tengri-zsh-preexec

executable tengri-zsh-preexec
  hs-source-dirs: app
  main-is: Main.hs
  default-language: GHC2024
  default-extensions:
    AllowAmbiguousTypes
    ApplicativeDo
    Arrows
    BlockArguments
    DerivingStrategies
    DerivingVia
    ExplicitNamespaces
    ImportQualifiedPost
    MultiWayIf
    NamedFieldPuns
    OverloadedLabels
    OverloadedRecordDot
    OverloadedRecordUpdate
    OverloadedStrings
    PackageImports
    PatternSynonyms
    QuasiQuotes
    RankNTypes
    RecordWildCards
    RequiredTypeArguments
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilyDependencies
    TypeOperators
    TypeSynonymInstances
    ViewPatterns
  ghc-options: -Wall -Wcompat -Wredundant-constraints -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 33,
    containers >= 0.6 && < 1,
    data-default >= 0.8 && < 1,
    directory >= 1.3 && < 2,
    filepath >= 1.4 && < 2,
    pointed >= 5.0 && < 6,

    -- my own stuff
    gongju >= 0.1 && < 1,
    polytropos-core >= 0.1.0.3 && < 1,
    polytropos-lens >= 0.1.0.3 && < 1,
    polytropos-optics >= 0.1.0.3 && < 1,
    polytropos-plugin >= 0.1.0.3 && < 1,
    penelope-core >= 0.1 && < 1,
    penelope-effects >= 0.1 && < 1,
    smirk >= 0.1 && < 1,
    smirk-penelope >= 0.1 && < 1,

