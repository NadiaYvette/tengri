cabal-version: 3.0
name: tengri-savdag
version: 0.1.0.0
synopsis: Warm GHC API daemon with SCM_RIGHTS and MCP introspection
description:
  Warm GHC API daemon with SCM_RIGHTS and MCP introspection for the tengri ecosystem.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/tengri
bug-reports: https://github.com/NadiaYvette/tengri/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.10.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/tengri
  subdir: packages/tengri-savdag

library
  exposed-modules:
    Tengri.Savdag
    Tengri.Savdag.Server
    Tengri.Savdag.MockSummary
    Tengri.Savdag.Monad
    Tengri.Savdag.Plugin
    Tengri.Savdag.Worker
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    ghc >= 9.10 && < 9.16,
    ghc-boot-th >= 9.10 && < 9.16,
    ghci >= 9.10 && < 9.16,
    ghc-paths >= 0.1 && < 0.2,
    polytropos-core >= 0.1.1.0 && < 0.2,
    polytropos-plugin >= 0.1.1.0 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    base >= 4.14 && < 5,
    tengri-savdag,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    hspec >= 2.10 && < 2.12
