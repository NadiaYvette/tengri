packages: packages/*/

with-compiler: ghc-9.14.1
write-ghc-environment-files: always
allow-newer: *

package *
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  haddock-options: -w

source-repository-package
  type: git
  location: https://github.com/NadiaYvette/polytropos
  tag: 0.1.0.3
  subdir: packages/polytropos-core
          packages/polytropos-lens
          packages/polytropos-optics
          packages/polytropos-plugin

source-repository-package
  type: git
  location: https://github.com/NadiaYvette/penelope
  tag: 0.1.0.0
  subdir: packages/penelope-core
          packages/penelope-effects
